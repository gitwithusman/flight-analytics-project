# Copy this file to ".env" and fill in your own values.
# The real .env file is git-ignored and must never be committed.

# NOTE: the shipped `.env` already contains the AviationStack key; this file is only a template.
# --- AviationStack (required for data retrieval) ---------------------------
# Free account: https://aviationstack.com  (free tier: /v1/flights endpoint)
AVIATIONSTACK_API_KEY=

# Free plan is HTTP-only - keep http:// here. Paid plans may use https://.
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# --- FlightAPI.io (optional) -----------------------------------------------
# Flight-search provider (airline, flight number, times, stops, duration).
# Get your key from your FlightAPI dashboard (https://api.flightapi.io/dashboard). Never commit it.
FLIGHTAPI_API_KEY=
FLIGHTAPI_BASE_URL=https://api.flightapi.io

# --- Flight search settings ---------------------------------------------------
# Leave FLIGHTAPI_API_KEY empty to use clearly labelled SAMPLE flights.
# 1 = always use SAMPLE flights even when a key is set (demonstrations).
SEARCH_FORCE_DEMO=0

# --- Appearance ----------------------------------------------------------------
# 1 = no animated sky / airplanes / page transitions (low-power or accessibility).
REDUCE_MOTION=0

# --- Request behaviour ------------------------------------------------------
REQUEST_TIMEOUT=20
DEFAULT_RECORD_LIMIT=100
# Transient failures (timeout / connection error / HTTP 5xx) are retried with
# exponential back-off: wait = RETRY_BACKOFF_SECONDS * 2**attempt.
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# --- Optional weather context (Open-Meteo, free, no key) -------------------
# Informational only - shown in the desktop status bar for a location you
# choose. Delays are attributed to weather ONLY if the flight API says so.
ENABLE_WEATHER_LOOKUP=1
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LABEL=Monitored location
